{
  "openapi": "3.0.3",
  "info": {
    "title": "EthersFlow Autonomous Agent Trust & Consensus API",
    "description": "Enterprise-grade multi-model federated adversarial consensus and agent action verification engine. Drop-in compatible with standard OpenAI and Anthropic SDKs.",
    "version": "0.3.1",
    "contact": {
      "name": "EthersFlow Developer Support",
      "email": "ethersflow.dev@gmail.com",
      "url": "https://www.ethersflow.com"
    }
  },
  "servers": [
    {
      "url": "https://www.ethersflow.com",
      "description": "Production API Gateway"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "EthersFlow API Key (ef_live_...)",
        "description": "Provide your EthersFlow API key in the Authorization header as 'Bearer <token>'."
      }
    },
    "schemas": {
      "ConsensusMetadata": {
        "type": "object",
        "properties": {
          "alignment_score": { "type": "number", "example": 98.6 },
          "verdict": { "type": "string", "example": "VERIFIED_CONSENSUS_ACHIEVED" },
          "hallucination_index": { "type": "number", "example": 0.014 },
          "risk_index": { "type": "number", "example": 1.4 },
          "sla_latency_ms": { "type": "integer", "example": 1840 },
          "sla_budget_ms": { "type": "integer", "nullable": true, "example": 2500 },
          "sla_status": { "type": "string", "example": "WITHIN_SLA_BUDGET" },
          "council_roster": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["FINRA/SEC Compliance Officer", "Quantitative Risk Auditor", "Market Manipulation Detector"]
          },
          "agent_count": { "type": "integer", "example": 3 },
          "adversarial_debate": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": { "type": "string" },
                "perspective": { "type": "string" },
                "node_status": { "type": "string" }
              }
            }
          },
          "zero_data_retention": { "type": "boolean", "example": true }
        }
      }
    }
  },
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "summary": "OpenAI-Compatible Multi-Model Adversarial Chat Completions",
        "description": "Drop-in OpenAI SDK proxy endpoint. Intercepts prompt, executes multi-model adversarial consensus in parallel, enforces zero data retention (ZDR), and returns synthesized response with consensus audit metadata.",
        "operationId": "chatCompletions",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "X-EthersFlow-Council",
            "in": "header",
            "required": false,
            "description": "JSON array of custom analyst roles (e.g. ['Fiduciary Auditor', 'SEC Compliance', 'Skeptic'])",
            "schema": { "type": "string" }
          },
          {
            "name": "X-EthersFlow-Persona-Preset",
            "in": "header",
            "required": false,
            "description": "Pre-configured auditor council preset",
            "schema": {
              "type": "string",
              "enum": ["clinical_safety", "financial_compliance", "legal_citation", "cybersecurity_auditor", "general_adversarial"]
            }
          },
          {
            "name": "X-EthersFlow-Agent-Count",
            "in": "header",
            "required": false,
            "description": "Number of parallel adversarial audit nodes (2 to 7, default 3)",
            "schema": { "type": "integer", "minimum": 2, "maximum": 7, "default": 3 }
          },
          {
            "name": "X-EthersFlow-Zero-Retention",
            "in": "header",
            "required": false,
            "description": "Enforce client-side PII token masking and zero logging across all nodes",
            "schema": { "type": "boolean", "default": true }
          },
          {
            "name": "X-EthersFlow-SLA-Timeout",
            "in": "header",
            "required": false,
            "description": "SLA latency budget target in milliseconds (e.g. 2500)",
            "schema": { "type": "integer" }
          },
          {
            "name": "X-EthersFlow-Callback-URL",
            "in": "header",
            "required": false,
            "description": "Webhook URL for asynchronous consensus delivery (returns HTTP 202 immediately)",
            "schema": { "type": "string", "format": "uri" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["messages"],
                "properties": {
                  "model": {
                    "type": "string",
                    "default": "ethersflow-adversarial-consensus-v1",
                    "example": "ethersflow-adversarial-consensus-v1"
                  },
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["role", "content"],
                      "properties": {
                        "role": { "type": "string", "enum": ["system", "user", "assistant"] },
                        "content": { "type": "string" }
                      }
                    }
                  },
                  "stream": { "type": "boolean", "default": false },
                  "response_format": { "type": "object" },
                  "agent_count": { "type": "integer", "minimum": 2, "maximum": 7 },
                  "persona_preset": { "type": "string" },
                  "callback_url": { "type": "string", "format": "uri" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Standard OpenAI Chat Completion with Top-Level & Choice-Level EthersFlow Consensus Metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "object": { "type": "string", "example": "chat.completion" },
                    "created": { "type": "integer" },
                    "model": { "type": "string" },
                    "choices": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "index": { "type": "integer" },
                          "message": {
                            "type": "object",
                            "properties": {
                              "role": { "type": "string" },
                              "content": { "type": "string" },
                              "ethersflow_consensus_metadata": { "$ref": "#/components/schemas/ConsensusMetadata" }
                            }
                          },
                          "finish_reason": { "type": "string" }
                        }
                      }
                    },
                    "usage": { "type": "object" },
                    "ethersflow_consensus_metadata": { "$ref": "#/components/schemas/ConsensusMetadata" }
                  }
                }
              }
            }
          },
          "202": {
            "description": "Asynchronous Consensus Task Queued (Dispatched to background pipeline and delivered via webhook)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string", "example": "ef_task_a7f92b4c10" },
                    "object": { "type": "string", "example": "chat.completion.task" },
                    "created": { "type": "integer" },
                    "status": { "type": "string", "example": "queued" },
                    "callback_url": { "type": "string" },
                    "zero_data_retention": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/messages": {
      "post": {
        "summary": "Anthropic-Compatible Multi-Model Adversarial Messages Endpoint",
        "description": "Drop-in Anthropic SDK (@anthropic-ai/sdk) proxy endpoint. Pass baseURL 'https://www.ethersflow.com'.",
        "operationId": "messages",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["messages"],
                "properties": {
                  "model": { "type": "string", "default": "ethersflow-adversarial-consensus-v1" },
                  "max_tokens": { "type": "integer", "default": 1024 },
                  "system": { "type": "string" },
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["role", "content"],
                      "properties": {
                        "role": { "type": "string", "enum": ["user", "assistant"] },
                        "content": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Standard Anthropic Message Response with Top-Level EthersFlow Consensus Metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "type": { "type": "string", "example": "message" },
                    "role": { "type": "string", "example": "assistant" },
                    "model": { "type": "string" },
                    "content": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": { "type": "string", "example": "text" },
                          "text": { "type": "string" }
                        }
                      }
                    },
                    "stop_reason": { "type": "string", "example": "end_turn" },
                    "usage": { "type": "object" },
                    "ethersflow_consensus_metadata": { "$ref": "#/components/schemas/ConsensusMetadata" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/verify": {
      "post": {
        "summary": "Verify Autonomous Agent Proposed Action",
        "description": "Gates an agent decision (e.g., execute_trade, send_email, approve_claim) using deterministic policy pre-screening and heterogeneous multi-model adversarial cross-examination. Supports caller-scoped 24h verdict idempotency (Option B) and echoes contractual request_id, trace_id, idempotency_key, client_reference_id, and latency_ms across every response.",
        "operationId": "verifyAgentAction",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional caller-supplied idempotency key (or pass idempotency_key in JSON body). Echoed in every response and deduplicates verdict issuance per (caller_key, idempotency_key) for 24 hours.",
            "schema": { "type": "string" }
          },
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": false,
            "description": "Optional caller correlation reference (or pass client_reference_id / correlation_id in JSON body) echoed back as client_reference_id for human-in-the-loop audit linkage.",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["agent_action"],
                "properties": {
                  "agent_action": {
                    "type": "string",
                    "example": "Execute $250,000 wire transfer to Vendor X"
                  },
                  "reasoning_chain": {
                    "type": "string",
                    "example": "Invoice PO-8841 matched vendor payment record; approval threshold under $500k auto-limit."
                  },
                  "idempotency_key": {
                    "type": "string",
                    "nullable": true,
                    "description": "Optional client idempotency key. Echoed verbatim at top level and deduplicates verdict issuance per caller key for 24 hours (replays return replayed: true and original_request_id; reusing the same key with a different payload returns 409 IDEMPOTENCY_KEY_CONFLICT). Downstream mutation idempotency remains the mutation caller's responsibility.",
                    "example": "idem_pay_20261113_0042"
                  },
                  "client_reference_id": {
                    "type": "string",
                    "nullable": true,
                    "description": "Optional workflow or ticket correlation ID (alias: correlation_id) echoed top-level to simplify audit linkage across async human-in-the-loop branches.",
                    "example": "n8n_exec_98412"
                  },
                  "agent_count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5,
                    "default": 2,
                    "example": 3
                  },
                  "persona_preset": {
                    "type": "string",
                    "enum": [
                      "clinical_safety",
                      "financial_compliance",
                      "legal_citation",
                      "cybersecurity_auditor",
                      "general_adversarial"
                    ],
                    "default": "financial_compliance",
                    "example": "financial_compliance"
                  },
                  "grounding_enabled": {
                    "type": "boolean",
                    "default": true
                  },
                  "zero_retention": {
                    "type": "boolean",
                    "default": true
                  },
                  "context": {
                    "type": "object",
                    "description": "Structured contextual evidence, metadata, scope grant, or source document references."
                  },
                  "scope_grant": {
                    "type": "object",
                    "description": "Explicit kernel-resolvable subject authorization or scope grant evidence (e.g. { grant_id, subject_id, subject_reference, grant_scope, data_class, access_level, issuing_authority, authorized_by, expires_at, consent_verified, status }).",
                    "properties": {
                      "grant_id": { "type": "string", "example": "grant_ef_clinical_verified_001" },
                      "subject_id": { "type": "string", "example": "000000" },
                      "subject_reference": { "type": "string", "example": "example subject record #000000" },
                      "grant_scope": { "type": "string", "example": "read:health_clinical_phi" },
                      "data_class": { "type": "string", "example": "HEALTH_CLINICAL_PHI" },
                      "access_level": { "type": "string", "example": "read_only" },
                      "issuing_authority": { "type": "string", "example": "attending_physician_or_dpo" },
                      "authorized_by": { "type": "string", "example": "Dr. Alex Rivera, MD" },
                      "expires_at": { "type": "string", "format": "date-time" },
                      "consent_verified": { "type": "boolean", "default": true },
                      "status": { "type": "string", "enum": ["VERIFIED", "APPROVED", "AUTHORIZED", "GRANTED", "ACTIVE"] }
                    }
                  },
                  "subject_scope_grant": {
                    "type": "object",
                    "description": "Direct subject scope authorization object."
                  },
                  "scope_hint": {
                    "type": "string",
                    "description": "Domain or task scope hint (e.g. 'clinical_safety', 'financial_compliance', 'legal_citation')."
                  },
                  "policy_id": {
                    "type": "string",
                    "description": "Policy pack identifier (e.g. 'finops_default_v1')."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification Verdict & Cryptographic Attestation Receipt",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["request_id", "verdict_id", "trace_id", "verdict", "status", "verified", "action_eligible", "latency_ms", "timestamp"],
                  "properties": {
                    "request_id": {
                      "type": "string",
                      "description": "Contractual top-level verification request identifier (bound inside Ed25519 attestation).",
                      "example": "req_efdaddb2b0f2c241"
                    },
                    "verdict_id": {
                      "type": "string",
                      "description": "Alias of request_id for downstream ledger linkage.",
                      "example": "req_efdaddb2b0f2c241"
                    },
                    "trace_id": {
                      "type": "string",
                      "description": "Contractual distributed trace identifier.",
                      "example": "trace_15eace2e942a89f427832d71"
                    },
                    "idempotency_key": {
                      "type": "string",
                      "nullable": true,
                      "description": "Echoed caller idempotency_key (or Idempotency-Key header); null when omitted.",
                      "example": "idem_pay_20261113_0042"
                    },
                    "client_reference_id": {
                      "type": "string",
                      "nullable": true,
                      "description": "Echoed caller correlation reference if supplied.",
                      "example": "n8n_exec_98412"
                    },
                    "replayed": {
                      "type": "boolean",
                      "description": "True when served from the 24h caller-scoped idempotency cache."
                    },
                    "original_request_id": {
                      "type": "string",
                      "nullable": true,
                      "description": "Present on replayed responses; equals request_id of the original verdict."
                    },
                    "verdict": {
                      "type": "string",
                      "enum": ["APPROVED", "FLAGGED_HUMAN_REVIEW", "REJECTED"]
                    },
                    "status": {
                      "type": "string",
                      "enum": ["APPROVED", "FLAGGED_HUMAN_REVIEW", "REJECTED"]
                    },
                    "verified": { "type": "boolean" },
                    "action_eligible": { "type": "boolean" },
                    "lane": { "type": "string", "enum": ["FAST_PATH", "CONSENSUS"] },
                    "policy_fast_path": { "type": "boolean" },
                    "consensus_score": { "type": "number", "example": 94.5 },
                    "risk_index": { "type": "number", "example": 5.5 },
                    "reviewer_agreement": { "type": "number", "example": 0.995 },
                    "reason_codes": { "type": "array", "items": { "type": "string" } },
                    "agent_action": { "type": "string" },
                    "agent_count": { "type": "integer" },
                    "persona_preset": { "type": "string" },
                    "adversarial_debate": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "role": { "type": "string" },
                          "perspective": { "type": "string" },
                          "node_status": { "type": "string" }
                        }
                      }
                    },
                    "attestation": { "type": "object" },
                    "receipt_v2": { "type": "object" },
                    "latency_ms": {
                      "type": "integer",
                      "description": "Server-side gateway evaluation duration in milliseconds."
                    },
                    "timestamp": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Malformed Request or Schema Validation Error (caller key authenticated; e.g. INVALID_PERSONA_PRESET, INVALID_AGENT_COUNT, MISSING_AGENT_ACTION)"
          },
          "401": {
            "description": "Authentication Failed (MISSING_AUTHORIZATION, MALFORMED_AUTHORIZATION_HEADER, REVOKED_API_KEY, ROTATED_API_KEY, or INVALID_API_KEY)"
          },
          "403": {
            "description": "Key Scope Mismatch (e.g. MIS_SCOPED_API_KEY when sandbox demo token is sent to live /api/v1/verify)"
          },
          "409": {
            "description": "Idempotency Conflict (IDEMPOTENCY_KEY_CONFLICT when the same idempotency_key is reused for different request parameters)"
          },
          "502": {
            "description": "Upstream Council Providers Unreachable (fail-closed GATEWAY_UPSTREAM_UNREACHABLE)"
          }
        }
      }
    },
    "/api/v1/sandbox/verify": {
      "post": {
        "summary": "Sandbox Agent Action Verification (Demo Key Accepted)",
        "description": "Identical verification contract to /api/v1/verify, accepting either live Bearer tokens or public sandbox token ef_sandbox_demo_show_hn.",
        "operationId": "verifyAgentActionSandbox",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Sandbox verification verdict receipt with contractual request_id, trace_id, idempotency_key, and latency_ms." },
          "400": { "description": "Schema validation error." },
          "401": { "description": "Authentication failed." }
        }
      }
    },
    "/api/v1/keys/create": {
      "post": {
        "summary": "Issue Live API Key (Account-Gated)",
        "description": "Provisions a new active ef_live_... Bearer key bound to an authenticated EthersFlow account.",
        "operationId": "createApiKey",
        "responses": {
          "200": { "description": "Issued API key object." },
          "401": { "description": "Account authentication required." }
        }
      }
    },
    "/api/v1/keys/rotate": {
      "post": {
        "summary": "Rotate Live API Key (Account-Gated)",
        "description": "Issues a successor ef_live_... key and marks the previous key rotated (or retains overlap when revoke_previous: false for zero-downtime cutover).",
        "operationId": "rotateApiKey",
        "responses": {
          "200": { "description": "Successor key issued." },
          "401": { "description": "Account authentication required." },
          "404": { "description": "Target key not found." }
        }
      }
    },
    "/api/v1/keys/revoke": {
      "post": {
        "summary": "Revoke Live API Key (Account-Gated)",
        "description": "Immediately revokes an active key; subsequent verify calls with that token fail closed with 401 REVOKED_API_KEY.",
        "operationId": "revokeApiKey",
        "responses": {
          "200": { "description": "Key revoked." },
          "401": { "description": "Account authentication required." }
        }
      }
    },
    "/api/mcp": {
      "post": {
        "summary": "Model Context Protocol (MCP) JSON-RPC 2.0 Server",
        "description": "Native MCP Server endpoint enabling LangChain, CrewAI, AutoGPT, Claude, or Cloudflare Workers to invoke EthersFlow verification as a tool.",
        "operationId": "mcpServerRPC",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["jsonrpc", "method"],
                "properties": {
                  "jsonrpc": { "type": "string", "example": "2.0" },
                  "id": { "type": "integer", "example": 1 },
                  "method": {
                    "type": "string",
                    "enum": ["initialize", "tools/list", "tools/call"]
                  },
                  "params": { "type": "object" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MCP Protocol Standard JSON-RPC Response"
          }
        }
      }
    }
  }
}

