{
  "openapi": "3.0.3",
  "info": {
    "title": "EthersFlow Autonomous Agent Trust & Consensus API",
    "description": "Enterprise-grade multi-model federated adversarial consensus and agent action verification engine. Drop-in compatible with standard OpenAI and Anthropic SDKs.",
    "version": "0.3.2",
    "contact": {
      "name": "EthersFlow Developer Support",
      "email": "ethersflow.dev@gmail.com",
      "url": "https://www.ethersflow.com"
    }
  },
  "servers": [
    {
      "url": "https://www.ethersflow.com",
      "description": "Production API Gateway"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local Development Server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "EthersFlow API Key (ef_sandbox_... or ef_live_...)",
        "description": "Provide your EthersFlow API key in the Authorization header as 'Bearer <token>'. Obtain an instant zero-signup sandbox key (ef_sandbox_..., 24h TTL) or live key (ef_live_...) at https://www.ethersflow.com/api-keys.html."
      }
    },
    "schemas": {
      "ConsensusMetadata": {
        "type": "object",
        "properties": {
          "alignment_score": { "type": "number", "example": 98.6 },
          "verdict": { "type": "string", "example": "VERIFIED_CONSENSUS_ACHIEVED" },
          "hallucination_index": { "type": "number", "example": 0.014 },
          "risk_index": { "type": "number", "example": 1.4 },
          "sla_latency_ms": { "type": "integer", "example": 1840 },
          "sla_budget_ms": { "type": "integer", "nullable": true, "example": 2500 },
          "sla_status": { "type": "string", "example": "WITHIN_SLA_BUDGET" },
          "council_roster": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["FINRA/SEC Compliance Officer", "Quantitative Risk Auditor", "Market Manipulation Detector"]
          },
          "agent_count": { "type": "integer", "example": 3 },
          "adversarial_debate": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": { "type": "string" },
                "perspective": { "type": "string" },
                "node_status": { "type": "string" }
              }
            }
          },
          "zero_data_retention": { "type": "boolean", "example": true }
        }
      },
      "PolicyRules": {
        "type": "object",
        "properties": {
          "max_amount_usd": { "type": "number", "nullable": true, "example": 5000 },
          "require_human_review_above_usd": { "type": "number", "nullable": true, "example": 500 },
          "blocked_verbs": { "type": "array", "items": { "type": "string" }, "example": ["drop", "truncate"] },
          "blocked_keywords": { "type": "array", "items": { "type": "string" }, "example": ["unapproved_vendor"] },
          "allowed_domains": { "type": "array", "items": { "type": "string" }, "example": ["corp.internal", "northstar.example"] },
          "blocked_domains": { "type": "array", "items": { "type": "string" }, "example": ["pastebin.com"] },
          "require_ticket_anchor": { "type": "boolean", "default": false },
          "fast_path_allowed": { "type": "boolean", "default": true },
          "default_verdict_on_violation": { "type": "string", "enum": ["REJECTED", "FLAGGED_HUMAN_REVIEW"], "default": "REJECTED" }
        }
      },
      "PolicyObject": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "pol_finops_strict_01" },
          "name": { "type": "string", "example": "Strict FinOps Treasury Limit" },
          "version": { "type": "string", "example": "1.0.0" },
          "source": { "type": "string", "enum": ["system", "custom", "inline"] },
          "read_only": { "type": "boolean" },
          "persona_preset": { "type": "string", "nullable": true },
          "description": { "type": "string" },
          "rules": { "$ref": "#/components/schemas/PolicyRules" },
          "custom_instructions": { "type": "string" },
          "policy_hash": { "type": "string", "description": "SHA-256 digest of the normalized policy definition bound into receipt_v2.policy_hash." },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "CustomPersonaObject": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "crypto_defi_risk" },
          "slug": { "type": "string", "example": "crypto_defi_risk" },
          "name": { "type": "string", "example": "DeFi Smart Contract & Bridge Risk Council" },
          "description": { "type": "string" },
          "roles": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["Smart Contract Auditor", "Bridge Liquidity Risk Analyst"]
          },
          "system_instructions": { "type": "string" },
          "default_policy_id": { "type": "string", "nullable": true },
          "source": { "type": "string", "enum": ["system", "custom"] },
          "read_only": { "type": "boolean" }
        }
      }
    }
  },
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "summary": "OpenAI-Compatible Multi-Model Adversarial Chat Completions",
        "description": "Drop-in OpenAI SDK proxy endpoint. Intercepts prompt, executes multi-model adversarial consensus in parallel, enforces zero data retention (ZDR), and returns synthesized response with consensus audit metadata.",
        "operationId": "chatCompletions",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "X-EthersFlow-Council",
            "in": "header",
            "required": false,
            "description": "JSON array of custom analyst roles (e.g. ['Fiduciary Auditor', 'SEC Compliance', 'Skeptic'])",
            "schema": { "type": "string" }
          },
          {
            "name": "X-EthersFlow-Persona-Preset",
            "in": "header",
            "required": false,
            "description": "Pre-configured auditor council preset",
            "schema": {
              "type": "string",
              "enum": ["clinical_safety", "financial_compliance", "legal_citation", "cybersecurity_auditor", "general_adversarial"]
            }
          },
          {
            "name": "X-EthersFlow-Agent-Count",
            "in": "header",
            "required": false,
            "description": "Number of parallel adversarial audit nodes (2 to 7, default 3)",
            "schema": { "type": "integer", "minimum": 2, "maximum": 7, "default": 3 }
          },
          {
            "name": "X-EthersFlow-Zero-Retention",
            "in": "header",
            "required": false,
            "description": "Enforce client-side PII token masking and zero logging across all nodes",
            "schema": { "type": "boolean", "default": true }
          },
          {
            "name": "X-EthersFlow-SLA-Timeout",
            "in": "header",
            "required": false,
            "description": "SLA latency budget target in milliseconds (e.g. 2500)",
            "schema": { "type": "integer" }
          },
          {
            "name": "X-EthersFlow-Callback-URL",
            "in": "header",
            "required": false,
            "description": "Webhook URL for asynchronous consensus delivery (returns HTTP 202 immediately)",
            "schema": { "type": "string", "format": "uri" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["messages"],
                "properties": {
                  "model": {
                    "type": "string",
                    "default": "ethersflow-adversarial-consensus-v1",
                    "example": "ethersflow-adversarial-consensus-v1"
                  },
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["role", "content"],
                      "properties": {
                        "role": { "type": "string", "enum": ["system", "user", "assistant"] },
                        "content": { "type": "string" }
                      }
                    }
                  },
                  "stream": { "type": "boolean", "default": false },
                  "response_format": { "type": "object" },
                  "agent_count": { "type": "integer", "minimum": 2, "maximum": 7 },
                  "persona_preset": { "type": "string" },
                  "callback_url": { "type": "string", "format": "uri" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Standard OpenAI Chat Completion with Top-Level & Choice-Level EthersFlow Consensus Metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "object": { "type": "string", "example": "chat.completion" },
                    "created": { "type": "integer" },
                    "model": { "type": "string" },
                    "choices": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "index": { "type": "integer" },
                          "message": {
                            "type": "object",
                            "properties": {
                              "role": { "type": "string" },
                              "content": { "type": "string" },
                              "ethersflow_consensus_metadata": { "$ref": "#/components/schemas/ConsensusMetadata" }
                            }
                          },
                          "finish_reason": { "type": "string" }
                        }
                      }
                    },
                    "usage": { "type": "object" },
                    "ethersflow_consensus_metadata": { "$ref": "#/components/schemas/ConsensusMetadata" }
                  }
                }
              }
            }
          },
          "202": {
            "description": "Asynchronous Consensus Task Queued (Dispatched to background pipeline and delivered via webhook)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string", "example": "ef_task_a7f92b4c10" },
                    "object": { "type": "string", "example": "chat.completion.task" },
                    "created": { "type": "integer" },
                    "status": { "type": "string", "example": "queued" },
                    "callback_url": { "type": "string" },
                    "zero_data_retention": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/messages": {
      "post": {
        "summary": "Anthropic-Compatible Multi-Model Adversarial Messages Endpoint",
        "description": "Drop-in Anthropic SDK (@anthropic-ai/sdk) proxy endpoint. Pass baseURL 'https://www.ethersflow.com'.",
        "operationId": "messages",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["messages"],
                "properties": {
                  "model": { "type": "string", "default": "ethersflow-adversarial-consensus-v1" },
                  "max_tokens": { "type": "integer", "default": 1024 },
                  "system": { "type": "string" },
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["role", "content"],
                      "properties": {
                        "role": { "type": "string", "enum": ["user", "assistant"] },
                        "content": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Standard Anthropic Message Response with Top-Level EthersFlow Consensus Metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "type": { "type": "string", "example": "message" },
                    "role": { "type": "string", "example": "assistant" },
                    "model": { "type": "string" },
                    "content": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": { "type": "string", "example": "text" },
                          "text": { "type": "string" }
                        }
                      }
                    },
                    "stop_reason": { "type": "string", "example": "end_turn" },
                    "usage": { "type": "object" },
                    "ethersflow_consensus_metadata": { "$ref": "#/components/schemas/ConsensusMetadata" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/verify": {
      "post": {
        "summary": "Verify Autonomous Agent Proposed Action",
        "description": "Gates an agent decision (e.g., execute_trade, send_email, approve_claim) using deterministic policy pre-screening and heterogeneous multi-model adversarial cross-examination. Supports caller-scoped 24h verdict idempotency (Option B) and echoes contractual request_id, trace_id, idempotency_key, client_reference_id, and latency_ms across every response.",
        "operationId": "verifyAgentAction",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional caller-supplied idempotency key (or pass idempotency_key in JSON body). Echoed in every response and deduplicates verdict issuance per (caller_key, idempotency_key) for 24 hours.",
            "schema": { "type": "string" }
          },
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": false,
            "description": "Optional caller correlation reference (or pass client_reference_id / correlation_id in JSON body) echoed back as client_reference_id for human-in-the-loop audit linkage.",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["agent_action"],
                "properties": {
                  "agent_action": {
                    "type": "string",
                    "example": "Execute $250,000 wire transfer to Vendor X"
                  },
                  "reasoning_chain": {
                    "type": "string",
                    "example": "Invoice PO-8841 matched vendor payment record; approval threshold under $500k auto-limit."
                  },
                  "idempotency_key": {
                    "type": "string",
                    "nullable": true,
                    "description": "Optional client idempotency key. Echoed verbatim at top level and deduplicates verdict issuance per caller key for 24 hours (replays return replayed: true and original_request_id; reusing the same key with a different payload returns 409 IDEMPOTENCY_KEY_CONFLICT). Downstream mutation idempotency remains the mutation caller's responsibility.",
                    "example": "idem_pay_20261113_0042"
                  },
                  "client_reference_id": {
                    "type": "string",
                    "nullable": true,
                    "description": "Optional workflow or ticket correlation ID (alias: correlation_id) echoed top-level to simplify audit linkage across async human-in-the-loop branches.",
                    "example": "n8n_exec_98412"
                  },
                  "agent_count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5,
                    "default": 2,
                    "example": 3
                  },
                  "persona_preset": {
                    "type": "string",
                    "description": "Built-in audit preset (clinical_safety, financial_compliance, legal_citation, cybersecurity_auditor, general_adversarial), a registered custom persona ID/slug created via POST /api/v1/personas, or an arbitrary custom label when paired with inline custom_personas / persona_instructions.",
                    "default": "financial_compliance",
                    "example": "financial_compliance"
                  },
                  "custom_personas": {
                    "type": "array",
                    "description": "Optional inline array of custom analyst role strings or objects ({ role, instructions }) used for flexible domain councils without pre-registration.",
                    "items": {
                      "oneOf": [
                        { "type": "string" },
                        {
                          "type": "object",
                          "properties": {
                            "role": { "type": "string" },
                            "instructions": { "type": "string" }
                          }
                        }
                      ]
                    }
                  },
                  "persona_instructions": {
                    "type": "string",
                    "description": "Optional inline domain audit instructions injected into all council reviewer prompts."
                  },
                  "grounding_enabled": {
                    "type": "boolean",
                    "default": true
                  },
                  "zero_retention": {
                    "type": "boolean",
                    "default": true
                  },
                  "context": {
                    "type": "object",
                    "description": "Structured contextual evidence, metadata, scope grant, or source document references."
                  },
                  "scope_grant": {
                    "type": "object",
                    "description": "Explicit kernel-resolvable subject authorization or scope grant evidence (e.g. { grant_id, subject_id, subject_reference, grant_scope, data_class, access_level, issuing_authority, authorized_by, expires_at, consent_verified, status }).",
                    "properties": {
                      "grant_id": { "type": "string", "example": "grant_ef_clinical_verified_001" },
                      "subject_id": { "type": "string", "example": "000000" },
                      "subject_reference": { "type": "string", "example": "example subject record #000000" },
                      "grant_scope": { "type": "string", "example": "read:health_clinical_phi" },
                      "data_class": { "type": "string", "example": "HEALTH_CLINICAL_PHI" },
                      "access_level": { "type": "string", "example": "read_only" },
                      "issuing_authority": { "type": "string", "example": "attending_physician_or_dpo" },
                      "authorized_by": { "type": "string", "example": "Dr. Alex Rivera, MD" },
                      "expires_at": { "type": "string", "format": "date-time" },
                      "consent_verified": { "type": "boolean", "default": true },
                      "status": { "type": "string", "enum": ["VERIFIED", "APPROVED", "AUTHORIZED", "GRANTED", "ACTIVE"] }
                    }
                  },
                  "subject_scope_grant": {
                    "type": "object",
                    "description": "Direct subject scope authorization object."
                  },
                  "scope_hint": {
                    "type": "string",
                    "description": "Domain or task scope hint (e.g. 'clinical_safety', 'financial_compliance', 'legal_citation')."
                  },
                  "policy_id": {
                    "type": "string",
                    "description": "System policy ID (e.g. 'finops_default_v1') or caller-registered custom policy ID from POST /api/v1/policies."
                  },
                  "policy": {
                    "type": "object",
                    "description": "Optional inline custom policy override object (supports max_amount_usd, require_human_review_above_usd, blocked_verbs, blocked_keywords, allowed_domains, blocked_domains, require_ticket_anchor, fast_path_allowed, default_verdict_on_violation, custom_instructions)."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification Verdict & Cryptographic Attestation Receipt",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["request_id", "verdict_id", "trace_id", "verdict", "status", "verified", "action_eligible", "latency_ms", "timestamp"],
                  "properties": {
                    "request_id": {
                      "type": "string",
                      "description": "Contractual top-level verification request identifier (bound inside Ed25519 attestation).",
                      "example": "req_efdaddb2b0f2c241"
                    },
                    "verdict_id": {
                      "type": "string",
                      "description": "Alias of request_id for downstream ledger linkage.",
                      "example": "req_efdaddb2b0f2c241"
                    },
                    "trace_id": {
                      "type": "string",
                      "description": "Contractual distributed trace identifier.",
                      "example": "trace_15eace2e942a89f427832d71"
                    },
                    "idempotency_key": {
                      "type": "string",
                      "nullable": true,
                      "description": "Echoed caller idempotency_key (or Idempotency-Key header); null when omitted.",
                      "example": "idem_pay_20261113_0042"
                    },
                    "client_reference_id": {
                      "type": "string",
                      "nullable": true,
                      "description": "Echoed caller correlation reference if supplied.",
                      "example": "n8n_exec_98412"
                    },
                    "replayed": {
                      "type": "boolean",
                      "description": "True when served from the 24h caller-scoped idempotency cache."
                    },
                    "original_request_id": {
                      "type": "string",
                      "nullable": true,
                      "description": "Present on replayed responses; equals request_id of the original verdict."
                    },
                    "verdict": {
                      "type": "string",
                      "enum": ["APPROVED", "FLAGGED_HUMAN_REVIEW", "REJECTED"]
                    },
                    "status": {
                      "type": "string",
                      "enum": ["APPROVED", "FLAGGED_HUMAN_REVIEW", "REJECTED"]
                    },
                    "verified": { "type": "boolean" },
                    "action_eligible": { "type": "boolean" },
                    "lane": { "type": "string", "enum": ["FAST_PATH", "CONSENSUS"] },
                    "policy_fast_path": { "type": "boolean" },
                    "consensus_score": { "type": "number", "example": 94.5 },
                    "risk_index": { "type": "number", "example": 5.5 },
                    "reviewer_agreement": { "type": "number", "example": 0.995 },
                    "reason_codes": { "type": "array", "items": { "type": "string" } },
                    "agent_action": { "type": "string" },
                    "agent_count": { "type": "integer" },
                    "persona_preset": { "type": "string" },
                    "resolved_persona": { "type": "string" },
                    "custom_personas_applied": { "type": "boolean" },
                    "council_roles": { "type": "array", "items": { "type": "string" } },
                    "policy_id": { "type": "string" },
                    "policy_version": { "type": "string" },
                    "policy_hash": { "type": "string" },
                    "custom_policy_applied": { "type": "boolean" },
                    "custom_policy_violations": { "type": "array", "items": { "type": "object" } },
                    "adversarial_debate": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "role": { "type": "string" },
                          "perspective": { "type": "string" },
                          "node_status": { "type": "string" }
                        }
                      }
                    },
                    "attestation": {
                      "type": "object",
                      "properties": {
                        "status": { "type": "string", "example": "VERIFIED_ED25519_SIG" },
                        "key_id": { "type": "string", "example": "ef_attest_v5" },
                        "algorithm": { "type": "string", "example": "Ed25519-EdDSA" },
                        "jwks_uri": { "type": "string", "example": "/.well-known/jwks.json" },
                        "public_key_url": { "type": "string", "example": "/api/v1/receipts/public-key" },
                        "verify_receipt_url": { "type": "string", "example": "/api/v1/verify-receipt" },
                        "public_key_base64url": { "type": "string" },
                        "public_key_hex": { "type": "string" },
                        "canonical_payload": { "type": "string" },
                        "payload_hash": { "type": "string" },
                        "signature": { "type": "string" }
                      }
                    },
                    "receipt_v2": { "type": "object" },
                    "latency_ms": {
                      "type": "integer",
                      "description": "Server-side gateway evaluation duration in milliseconds."
                    },
                    "timestamp": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Malformed Request or Schema Validation Error (caller key authenticated; e.g. INVALID_PERSONA_PRESET, INVALID_AGENT_COUNT, MISSING_AGENT_ACTION)"
          },
          "401": {
            "description": "Authentication Failed (MISSING_AUTHORIZATION, MALFORMED_AUTHORIZATION_HEADER, REVOKED_API_KEY, ROTATED_API_KEY, or INVALID_API_KEY)"
          },
          "403": {
            "description": "Key Scope Mismatch (e.g. MIS_SCOPED_API_KEY when sandbox demo token is sent to live /api/v1/verify)"
          },
          "404": {
            "description": "Referenced Custom Policy Not Found (POLICY_NOT_FOUND)"
          },
          "409": {
            "description": "Idempotency Conflict (IDEMPOTENCY_KEY_CONFLICT when the same idempotency_key is reused for different request parameters)"
          },
          "502": {
            "description": "Upstream Council Providers Unreachable (fail-closed GATEWAY_UPSTREAM_UNREACHABLE)"
          }
        }
      }
    },
    "/api/v1/sandbox/verify": {
      "post": {
        "summary": "Sandbox Agent Action Verification (Demo Key Accepted)",
        "description": "Identical verification contract to /api/v1/verify, accepting either live Bearer tokens or public sandbox token ef_sandbox_demo_show_hn.",
        "operationId": "verifyAgentActionSandbox",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Sandbox verification verdict receipt with contractual request_id, trace_id, idempotency_key, and latency_ms." },
          "400": { "description": "Schema validation error." },
          "401": { "description": "Authentication failed." }
        }
      }
    },
    "/api/v1/keys/sandbox": {
      "post": {
        "summary": "Mint Instant Zero-Signup Sandbox API Key",
        "description": "Provisions an ephemeral ef_sandbox_... Bearer key with zero sign-up (24h TTL, 60 verdicts/hr, IP rate-limited at 40 keys/hr). Accepted directly on POST /api/v1/verify and POST /api/mcp. Self-serve web UI available at https://www.ethersflow.com/api-keys.html.",
        "operationId": "createSandboxApiKey",
        "security": [],
        "responses": {
          "200": { "description": "Ephemeral sandbox API key issued (shown once)." },
          "429": { "description": "Per-IP sandbox mint rate limit exceeded." }
        }
      }
    },
    "/api/v1/keys/create": {
      "post": {
        "summary": "Issue Live API Key (Account-Gated)",
        "description": "Provisions a new active ef_live_... Bearer key bound to an authenticated EthersFlow account.",
        "operationId": "createApiKey",
        "responses": {
          "200": { "description": "Issued API key object." },
          "401": { "description": "Account authentication required." }
        }
      }
    },
    "/api/v1/keys/rotate": {
      "post": {
        "summary": "Rotate Live API Key (Account-Gated)",
        "description": "Issues a successor ef_live_... key and marks the previous key rotated (or retains overlap when revoke_previous: false for zero-downtime cutover).",
        "operationId": "rotateApiKey",
        "responses": {
          "200": { "description": "Successor key issued." },
          "401": { "description": "Account authentication required." },
          "404": { "description": "Target key not found." }
        }
      }
    },
    "/api/v1/keys/revoke": {
      "post": {
        "summary": "Revoke Live API Key (Account-Gated)",
        "description": "Immediately revokes an active key; subsequent verify calls with that token fail closed with 401 REVOKED_API_KEY.",
        "operationId": "revokeApiKey",
        "responses": {
          "200": { "description": "Key revoked." },
          "401": { "description": "Account authentication required." }
        }
      }
    },
    "/api/mcp": {
      "post": {
        "summary": "Model Context Protocol (MCP) JSON-RPC 2.0 Server",
        "description": "Native MCP Server endpoint enabling LangChain, CrewAI, AutoGPT, Claude, or Cloudflare Workers to invoke EthersFlow verification as a tool.",
        "operationId": "mcpServerRPC",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["jsonrpc", "method"],
                "properties": {
                  "jsonrpc": { "type": "string", "example": "2.0" },
                  "id": { "type": "integer", "example": 1 },
                  "method": {
                    "type": "string",
                    "enum": ["initialize", "tools/list", "tools/call"]
                  },
                  "params": { "type": "object" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MCP Protocol Standard JSON-RPC Response"
          }
        }
      }
    },
    "/api/v1/policies": {
      "get": {
        "summary": "List System & Caller-Scoped Custom Policies",
        "description": "Returns read-only built-in system policies together with all custom verification policies created by the authenticated caller.",
        "operationId": "listPolicies",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "System and custom policy catalog",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "policies": { "type": "array", "items": { "$ref": "#/components/schemas/PolicyObject" } },
                    "system_policies": { "type": "array", "items": { "$ref": "#/components/schemas/PolicyObject" } },
                    "custom_policies": { "type": "array", "items": { "$ref": "#/components/schemas/PolicyObject" } },
                    "total": { "type": "integer" }
                  }
                }
              }
            }
          },
          "401": { "description": "Authentication Failed" }
        }
      },
      "post": {
        "summary": "Create Caller-Scoped Custom Policy",
        "description": "Creates a reusable governance policy evaluated at runtime inside POST /api/v1/verify and bound cryptographically via policy_hash in receipt_v2.",
        "operationId": "createPolicy",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": { "type": "string", "description": "Optional slug identifier; auto-generated if omitted." },
                  "name": { "type": "string", "example": "Treasury Guardrail v1" },
                  "version": { "type": "string", "default": "1.0.0" },
                  "persona_preset": { "type": "string" },
                  "description": { "type": "string" },
                  "rules": { "$ref": "#/components/schemas/PolicyRules" },
                  "custom_instructions": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created custom policy with computed policy_hash" },
          "400": { "description": "Validation error (e.g. MISSING_POLICY_NAME)" },
          "401": { "description": "Authentication Failed" },
          "403": { "description": "System policy ID collision (SYSTEM_POLICY_READ_ONLY)" },
          "409": { "description": "Policy ID already exists (POLICY_ALREADY_EXISTS)" }
        }
      }
    },
    "/api/v1/policies/{policy_id}": {
      "parameters": [
        { "name": "policy_id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "get": {
        "summary": "Get Policy by ID",
        "operationId": "getPolicy",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Policy object" },
          "401": { "description": "Authentication Failed" },
          "404": { "description": "Policy not found (POLICY_NOT_FOUND)" }
        }
      },
      "put": {
        "summary": "Replace / Update Custom Policy",
        "operationId": "replacePolicy",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Updated policy with refreshed policy_hash" },
          "401": { "description": "Authentication Failed" },
          "403": { "description": "Built-in system policy is read-only (SYSTEM_POLICY_READ_ONLY)" },
          "404": { "description": "Custom policy not found" }
        }
      },
      "patch": {
        "summary": "Partially Update Custom Policy",
        "operationId": "patchPolicy",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Updated policy with refreshed policy_hash" },
          "401": { "description": "Authentication Failed" },
          "403": { "description": "Built-in system policy is read-only (SYSTEM_POLICY_READ_ONLY)" },
          "404": { "description": "Custom policy not found" }
        }
      },
      "delete": {
        "summary": "Delete Custom Policy",
        "operationId": "deletePolicy",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Custom policy deleted" },
          "401": { "description": "Authentication Failed" },
          "403": { "description": "Built-in system policy is read-only (SYSTEM_POLICY_READ_ONLY)" },
          "404": { "description": "Custom policy not found" }
        }
      }
    },
    "/api/v1/personas": {
      "get": {
        "summary": "List Built-In & Caller Custom Personas",
        "description": "Returns built-in system auditor presets plus all caller-registered custom personas usable as persona_preset on POST /api/v1/verify.",
        "operationId": "listPersonas",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Persona catalog",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "personas": { "type": "array", "items": { "$ref": "#/components/schemas/CustomPersonaObject" } },
                    "system_personas": { "type": "array", "items": { "$ref": "#/components/schemas/CustomPersonaObject" } },
                    "custom_personas": { "type": "array", "items": { "$ref": "#/components/schemas/CustomPersonaObject" } }
                  }
                }
              }
            }
          },
          "401": { "description": "Authentication Failed" }
        }
      },
      "post": {
        "summary": "Register Caller-Scoped Custom Persona",
        "description": "Registers a custom persona slug and council roles so callers can pass persona_preset: '<slug>' directly in POST /api/v1/verify or POST /api/mcp.",
        "operationId": "createPersona",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "slug": { "type": "string", "example": "crypto_defi_risk" },
                  "name": { "type": "string", "example": "DeFi Smart Contract Risk" },
                  "description": { "type": "string" },
                  "roles": { "type": "array", "items": { "type": "string" } },
                  "system_instructions": { "type": "string" },
                  "default_policy_id": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Registered custom persona" },
          "400": { "description": "Missing persona name" },
          "401": { "description": "Authentication Failed" },
          "403": { "description": "Built-in persona slug collision" },
          "409": { "description": "Persona slug already exists" }
        }
      }
    },
    "/api/v1/personas/{persona_id}": {
      "parameters": [
        { "name": "persona_id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "get": {
        "summary": "Get Persona by ID or Slug",
        "operationId": "getPersona",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Persona object" }, "404": { "description": "Not found" } }
      },
      "put": {
        "summary": "Update Custom Persona",
        "operationId": "replacePersona",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Updated persona" }, "403": { "description": "System persona read-only" }, "404": { "description": "Not found" } }
      },
      "patch": {
        "summary": "Partially Update Custom Persona",
        "operationId": "patchPersona",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Updated persona" }, "403": { "description": "System persona read-only" }, "404": { "description": "Not found" } }
      },
      "delete": {
        "summary": "Delete Custom Persona",
        "operationId": "deletePersona",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Deleted" }, "403": { "description": "System persona read-only" }, "404": { "description": "Not found" } }
      }
    },
    "/.well-known/jwks.json": {
      "get": {
        "summary": "Public Ed25519 JWKS Discovery (RFC 8037 OKP Profile)",
        "description": "Public unauthenticated JWKS endpoint publishing EthersFlow's active Ed25519 receipt-signing public key (kty: OKP, crv: Ed25519). Aliased at /.well-known/ethersflow-jwks.json and /.well-known/attestation.json.",
        "operationId": "getPublicJwks",
        "security": [],
        "responses": {
          "200": {
            "description": "RFC 8037 JWK Set",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "keys": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "kty": { "type": "string", "example": "OKP" },
                          "crv": { "type": "string", "example": "Ed25519" },
                          "alg": { "type": "string", "example": "Ed25519" },
                          "use": { "type": "string", "example": "sig" },
                          "kid": { "type": "string", "example": "ef_attest_v5" },
                          "x": { "type": "string", "description": "Base64url-encoded 32-byte raw Ed25519 public key" },
                          "public_key_hex": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/receipts/public-key": {
      "get": {
        "summary": "Retrieve Signing Public Key (JWK, PEM, SPKI DER, Hex)",
        "description": "Public endpoint returning EthersFlow's active Ed25519 signing public key in JWK, raw hex, SPKI DER hex, and PEM formats alongside canonical_serialization_spec.",
        "operationId": "getReceiptPublicKey",
        "security": [],
        "responses": {
          "200": { "description": "Public key descriptor and canonical serialization specification" }
        }
      }
    },
    "/api/v1/verify-receipt": {
      "post": {
        "summary": "Verify Signed Verdict Attestation Payload",
        "description": "Statelessly verifies an EthersFlow Ed25519 attestation object ({ attestation } or { canonical_payload, signature }) against the gateway's active signing key.",
        "operationId": "verifyReceiptAttestation",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "attestation": {
                    "type": "object",
                    "properties": {
                      "canonical_payload": { "type": "string" },
                      "signature": { "type": "string" }
                    }
                  },
                  "canonical_payload": { "type": "string" },
                  "signature": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cryptographic verification result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "verified": { "type": "boolean" },
                    "key_id": { "type": "string" },
                    "algorithm": { "type": "string", "example": "Ed25519-EdDSA" },
                    "payload_hash": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

