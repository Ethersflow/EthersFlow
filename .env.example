# EthersFlow Security Configuration
# Allowed API keys (comma-separated or JSON array) for live production and integrator verification.
# Required: Gateway enforces fail-closed startup check and refuses to boot if empty.
ETHERSFLOW_ALLOWED_KEYS=

# Optional: Persistent 32-byte hex seed for Ed25519 attestation key continuity across container redeploys.
ETHERSFLOW_ATTESTATION_SEED=

# Optional: Git commit SHA injected by CI build pipeline for build manifest traceability.
BUILD_REVISION=
