# Stripe Configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Cloud / Vertex AI
# The Google Cloud Project ID only (e.g. "my-project-123"). Find this in your key JSON as 'project_id'
GOOGLE_CLOUD_PROJECT=

# The FULL JSON content of your Service Account Key file. Paste the entire contents of the .json file here.
GCP_SERVICE_ACCOUNT_KEY=

# Other LLM Providers (Server Side)
GROQ_API_KEY=
OPENROUTER_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OPENAI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Public variables
VITE_STRIPE_PUBLISHABLE_KEY=

# GTM Pipeline Passcode Lock
GTM_ADMIN_PASSCODE=
