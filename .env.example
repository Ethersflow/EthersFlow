# EthersFlow Security Configuration
# Allowed API keys (comma-separated or JSON array) for live production and integrator verification.
# Required: Gateway enforces fail-closed startup check and refuses to boot if empty.
ETHERSFLOW_ALLOWED_KEYS=

# Unified Firebase Authentication (required in production so /api-keys.html, /app, and /keys authenticate against your Firebase project)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

