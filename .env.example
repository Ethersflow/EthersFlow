# EthersFlow Security & Environment Configuration

# Optional: Custom API key(s) for API authorization (e.g. ef_live_demo_key_2026).
# If left blank or defaulted, EthersFlow accepts built-in sandbox & demo keys.
ETHERSFLOW_ALLOWED_KEYS=ef_live_demo_key_2026

# Optional: 32-byte hex seed (64 chars) for persistent Ed25519 attestation signing key.
# If left blank, EthersFlow automatically generates a CSPRNG seed saved in .data/attestation_key.json.
ETHERSFLOW_ATTESTATION_SEED=

# Optional: Git commit SHA injected by CI pipeline (e.g. 893a706).
# If left blank, EthersFlow automatically calculates the build revision hash.
BUILD_REVISION=

