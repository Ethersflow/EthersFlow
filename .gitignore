# ==============================================================================
# STRICT REPO BOUNDARY: IGNORE ALL FILES AND DIRECTORIES BY DEFAULT
# ==============================================================================
/*

# ==============================================================================
# ALLOWLIST: ONLY PUBLIC MCP SERVER, SDKs, CLIENT VERIFIERS, AND METADATA
# ==============================================================================
!/.gitignore
!/.env.example
!/LICENSE
!/README.md
!/efverify.py
!/llms-install.md
!/server.json
!/smithery.yaml

# Workflows
!/.github
!/.github/workflows
!/.github/workflows/publish.yml
!/.github/workflows/repo-scope-guard.yml

# Public specifications & assets
!/public
/public/*
!/public/EthersFlow Logo - Edited.png
!/public/ethersflow-logo-400.png
!/public/mcp_manifest.json
!/public/openapi.json

# MCP Server
!/mcp-server
!/mcp-server/**
/mcp-server/node_modules
/mcp-server/.env
/mcp-server/.env.*
!/mcp-server/.env.example

# Python & TypeScript SDKs
!/sdk
!/sdk/**
/sdk/**/node_modules
/sdk/**/dist
/sdk/**/__pycache__
/sdk/**/*.pyc

# Postman collection & environment
!/postman
!/postman/**

# Explicit safeguard against any sensitive or proprietary files
.env
*.pem
*.key
*.secret
node_modules/
dist/
build/
*.log
.DS_Store

# Credential and internal evidence artifacts
.data/
*.seed
*.seed_hex
attestation_key.json
addendum*_evidence.json
battery_results.txt
consecutive_builds_evidence.json
