              { "key": "Authorization", "value": "Bearer {{apiKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agent_action\": \"$50 office supplies (micro-expense)\",\n  \"reasoning_chain\": \"Standard corporate procurement for office paper and pens.\",\n  \"persona_preset\": \"financial_compliance\",\n  \"agent_count\": 3,\n  \"zero_retention\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "verify"]
            },
            "description": "Standard benign micro-expense that achieves 100% node consensus alignment and APPROVED status."
          }
        },
