  "item": [
    {
      "name": "Core System & Attestation",
      "item": [
        {
          "name": "1. Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Verifies live service health, active FAC pipeline status, and build version."
          }
        },
        {
          "name": "2. JWKS Public Key Set",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/.well-known/jwks.json",
              "host": ["{{baseUrl}}"],
              "path": [".well-known", "jwks.json"]
            },
            "description": "Retrieves public Ed25519 OKP verification keys for independent offline signature verification."
          }
        },
        {
          "name": "3. Attestation Manifest",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/.well-known/attestation.json",
              "host": ["{{baseUrl}}"],
              "path": [".well-known", "attestation.json"]
            },
            "description": "Retrieves the Ed25519-EdDSA authority attestation configuration."
          }
        }
      ]
    },
    {
