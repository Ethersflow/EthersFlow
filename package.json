{
  "name": "ethersflow",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "mcp": "node mcp-server/index.js",
    "publish:mcp": "cd mcp-server && npm publish --access public",
    "build:sdk:ts": "tsc -p sdk/typescript/tsconfig.json",
    "publish:sdk:ts": "cd sdk/typescript && npm run build && npm publish --access public",
    "test": "node scripts/test_regression.mjs && node scripts/test_auth_battery.mjs",
    "test:auth": "node scripts/test_auth_battery.mjs",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google-cloud/vertexai": "^1.12.0",
    "@google/genai": "^2.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@stripe/stripe-js": "^4.1.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "firebase": "^11.2.0",
    "firebase-admin": "^13.1.0",
    "lucide-react": "^0.454.0",
    "mammoth": "^1.12.0",
    "motion": "^11.18.2",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^6.0.227",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.0",
    "recharts": "^3.9.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.12.3",
    "stripe": "^17.0.0",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0-alpha.31",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.23.0",
    "eslint": "^9.12.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.0.0-alpha.31",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  },
  "overrides": {
    "esbuild": "$esbuild",
    "node-domexception": "file:shims/node-domexception"
  }
}
